class Solution:
    def longestPalindrome(self, s: str) -> str:
        longest=s[0]
        for i in range(len(s)):
            for j in range(i+1,len(s)):
                sub=s[i:j+1]
                if(sub==sub[::-1]):
                    if(len(sub)>len(longest)):
                        longest=sub
        return longest
       
        
