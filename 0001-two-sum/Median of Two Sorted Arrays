class Solution(object):
    def findMedianSortedArrays(self, nums1, nums2):
        nums3=sorted(nums1+nums2)
        if(len(nums3)%2!=0):
            return nums3[len(nums3)//2]
        else:
            r=len(nums3)/2
            return (nums3[r]+nums3[r-1])/2
s1=Solution()
s2=Solution()
s1.findMedianSortedArrays([1,3],[2])
s2.findMedianSortedArrays([1,2],[3,4])

        
